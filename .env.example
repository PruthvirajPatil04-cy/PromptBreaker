# PromptBreaker AI — environment template
# Copy to .env and fill in. NEVER commit the real .env.

# Storage — dev uses SQLite; production: postgresql+asyncpg://user:pass@host/promptbreaker
PB_DATABASE_URL=sqlite+aiosqlite:///./data/promptbreaker.db

# Judge / attack-gen model (self-hosted by default — e.g. vLLM or Ollama
# behind an OpenAI-compatible endpoint). No provider ToS exposure.
PB_JUDGE_BASE_URL=http://localhost:11434/v1
PB_JUDGE_API_KEY=not-needed
PB_JUDGE_MODEL=qwen2.5:14b
PB_LLM_JUDGE_ENABLED=true

# Evidence HMAC key — 64 hex chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
PB_EVIDENCE_HMAC_KEY=CHANGE_ME_64_HEX_CHARS

# Comma-separated sha256 hashes of API keys (never plaintext).
# Hash one: echo -n "your-key" | sha256sum
PB_API_KEYS=

# API / CORS
PB_API_HOST=0.0.0.0
PB_API_PORT=8000
PB_CORS_ORIGINS=http://localhost:3000

# Hard budget caps (the engine refuses to exceed these)
PB_MAX_PROBES_PER_RUN=500
PB_MAX_MUTATIONS_PER_PROBE=8
PB_MAX_RUN_TOKENS=2000000
PB_MAX_RUN_COST_USD=25.0
PB_RUN_TIMEOUT_SECONDS=1800

# SSRF guard — keep false unless testing an owned lab on private ranges
PB_ALLOW_PRIVATE_TARGETS=false
PB_MAX_REDIRECTS=3

# Dashboard → API (used when lib/api.ts USE_MOCK=false; baked at build time)
NEXT_PUBLIC_PB_API_BASE=http://localhost:8000
